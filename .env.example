# Local Docker Compose only. Copy to .env and replace both passwords with unique local values.
LOCAL_MARIADB_USER=vertex
LOCAL_MARIADB_PASSWORD=replace-with-a-local-only-password
LOCAL_MARIADB_DATABASE=vertex_trading
LOCAL_MARIADB_ROOT_PASSWORD=replace-with-a-different-local-only-password

# Optional local-development overrides; do not reuse production secrets.
# JWT_ACCESS_SECRET=local-development-access-secret
# JWT_REFRESH_SECRET=local-development-refresh-secret
# JWT_ADMIN_SECRET=local-development-admin-secret
# ENCRYPTION_KEY=local-development-encryption-placeholder
# CORS_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
