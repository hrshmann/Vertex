NODE_ENV=development
PORT=4000

# MariaDB connection (Hostinger: copy these values from hPanel)
DB_HOST=your-mariadb-host
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_database_user
DB_PASSWORD=replace-with-your-database-password
# Set true when your database provider requires TLS
DB_SSL=false

# JWT signing secrets — generate real random values for anything beyond local dev, e.g.:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ADMIN_SECRET=change-me-admin
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
JWT_ADMIN_TTL=8h

# AES-256-GCM key for encrypting secrets at rest (exchange API keys, 2FA secrets).
# 64 hex chars (32 bytes) recommended, e.g.: openssl rand -hex 32
ENCRYPTION_KEY=change-me-64-hex-chars-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Must match the frontend's origin for cookies/CORS to work
CORS_ORIGIN=http://localhost:3000
# Number of trusted reverse-proxy hops. Set to the value documented by your host.
TRUST_PROXY_HOPS=0

# Market data providers — see README.md "Market data providers"
BINANCE_WS_BASE=wss://stream.binance.com:9443
BINANCE_REST_BASE=https://api.binance.com
FOREX_INDICATIVE_BASE=https://api.frankfurter.dev/v1
FOREX_POLL_INTERVAL_MS=60000

# Used only by `npm run seed:admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=